# Neon Postgres connection string
DATABASE_URL=

# Admin login (see .env.local, gitignored)
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=

# Cloudflare R2 — bucket for resumes, CVs, certificates, project reports
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL files are served from (R2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=
